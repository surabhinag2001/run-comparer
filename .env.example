# Copy this file to .env for local dev (never commit the real .env).
# In production, set these as environment variables in your host's
# dashboard instead of shipping a .env file.

# From https://www.strava.com/settings/api after registering an app.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Where the database lives. Local dev default is a plain SQLite file
# (no account needed): file:./data/app.db
# In production (e.g. Render, whose free tier has no persistent disk),
# point this at a Turso database instead: libsql://your-db.turso.io
# and set DB_AUTH_TOKEN — see README "Deploying" section.
DB_URL=file:./data/app.db
DB_AUTH_TOKEN=

PORT=3000

# Set to 1 ONLY for local testing without real Strava credentials.
# Never set this in production — it serves fake canned data to everyone.
MOCK_STRAVA=0
